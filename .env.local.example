# --- Agora core (required for real RTC + Conversational AI) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Conversational AI Engine REST auth (Basic <base64(key:secret)>)
# Generate the base64 string from your Agora Console RESTful API key/secret.
AGORA_CONVOAI_BASIC_AUTH=

# Region for the Conversational AI Engine ("na", "ap", "eu", "cn")
AGORA_CONVOAI_AREA=na

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_AGORA_APP_ID=

# If any of the above are missing, Saarthi automatically falls back to
# demo mode (see lib/demoEngine.ts) and clearly labels the UI as DEMO MODE.
